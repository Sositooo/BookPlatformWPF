<Window x:Class="BookPlatformWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши"
        Height="460" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="310">

            <TextBlock Text="📚 Читай, Пиши и не спиши"
                       FontSize="17" FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,18" Foreground="#333"/>

            <TabControl x:Name="TabControl"
                        SelectionChanged="TabControl_SelectionChanged">

                <!-- Вкладка входа -->
                <TabItem Header="Войти">
                    <StackPanel Margin="12">
                        <TextBlock Text="Логин" Margin="0,4,0,2"/>
                        <TextBox x:Name="TxtLoginIn" Height="30" Padding="5"/>

                        <TextBlock Text="Пароль" Margin="0,10,0,2"/>
                        <PasswordBox x:Name="TxtPasswordIn" Height="30" Padding="5"/>

                        <TextBlock x:Name="LblLoginError"
                                   Foreground="Red" Margin="0,6"
                                   TextWrapping="Wrap"/>

                        <Button Content="Войти" Height="36"
                                Margin="0,8,0,0"
                                Background="#4A90D9" Foreground="White"
                                FontWeight="Bold"
                                Click="BtnLogin_Click"/>
                    </StackPanel>
                </TabItem>

                <!-- Вкладка регистрации -->
                <TabItem Header="Регистрация">
                    <StackPanel Margin="12">
                        <TextBlock Text="Логин" Margin="0,4,0,2"/>
                        <TextBox x:Name="TxtLoginReg" Height="28" Padding="4"/>

                        <TextBlock Text="Отображаемое имя" Margin="0,8,0,2"/>
                        <TextBox x:Name="TxtDisplayName" Height="28" Padding="4"/>

                        <TextBlock Text="Email" Margin="0,8,0,2"/>
                        <TextBox x:Name="TxtEmailReg" Height="28" Padding="4"/>

                        <TextBlock Text="Пароль" Margin="0,8,0,2"/>
                        <PasswordBox x:Name="TxtPasswordReg" Height="28" Padding="4"/>

                        <TextBlock x:Name="LblRegError"
                                   Foreground="Red" Margin="0,6"
                                   TextWrapping="Wrap"/>

                        <Button Content="Зарегистрироваться" Height="36"
                                Margin="0,8,0,0"
                                Background="#27AE60" Foreground="White"
                                FontWeight="Bold"
                                Click="BtnRegister_Click"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </StackPanel>
    </Grid>
</Window>