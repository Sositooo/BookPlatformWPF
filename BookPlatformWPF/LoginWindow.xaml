<Window x:Class="BookPlatformWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши" Height="450" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <TextBlock Text="📚 Читай, Пиши и не спиши"
                       FontSize="18" FontWeight="Bold" TextAlignment="Center"
                       Margin="0,0,0,20" Foreground="#333"/>

            <!-- ВКЛАДКИ -->
            <TabControl x:Name="TabControl" SelectionChanged="TabControl_SelectionChanged">

                <!-- Авторизация -->
                <TabItem Header="Войти">
                    <StackPanel Margin="10">
                        <TextBlock Text="Логин" Margin="0,5"/>
                        <TextBox x:Name="TxtLoginIn" Height="30" Padding="5"/>
                        <TextBlock Text="Пароль" Margin="0,10,0,5"/>
                        <PasswordBox x:Name="TxtPasswordIn" Height="30" Padding="5"/>
                        <TextBlock x:Name="LblLoginError" Foreground="Red"
                                   Margin="0,5" TextWrapping="Wrap"/>
                        <Button Content="Войти" Height="35" Margin="0,10,0,0"
                                Background="#4A90D9" Foreground="White"
                                FontWeight="Bold" Click="BtnLogin_Click"/>
                    </StackPanel>
                </TabItem>

                <!-- Регистрация -->
                <TabItem Header="Регистрация">
                    <StackPanel Margin="10">
                        <TextBlock Text="Логин" Margin="0,3"/>
                        <TextBox x:Name="TxtLoginReg" Height="28" Padding="4"/>
                        <TextBlock Text="Имя (отображаемое)" Margin="0,6,0,3"/>
                        <TextBox x:Name="TxtDisplayName" Height="28" Padding="4"/>
                        <TextBlock Text="Email" Margin="0,6,0,3"/>
                        <TextBox x:Name="TxtEmailReg" Height="28" Padding="4"/>
                        <TextBlock Text="Пароль" Margin="0,6,0,3"/>
                        <PasswordBox x:Name="TxtPasswordReg" Height="28" Padding="4"/>
                        <TextBlock x:Name="LblRegError" Foreground="Red"
                                   Margin="0,5" TextWrapping="Wrap"/>
                        <Button Content="Зарегистрироваться" Height="35" Margin="0,10,0,0"
                                Background="#27AE60" Foreground="White"
                                FontWeight="Bold" Click="BtnRegister_Click"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </StackPanel>
    </Grid>
</Window>