<Page x:Class="BookPlatformWPF.Pages.ReadingListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Списки книг">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📋 Мои списки книг"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Вкладки разделов -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Читаю"     Tag="Читаю"     Click="BtnTab_Click"
                    Padding="12,5" Margin="0,0,5,0"/>
            <Button Content="Прочитано" Tag="Прочитано" Click="BtnTab_Click"
                    Padding="12,5" Margin="0,0,5,0"/>
            <Button Content="В планах"  Tag="В планах"  Click="BtnTab_Click"
                    Padding="12,5" Margin="0,0,5,0"/>
            <Button Content="Заброшено" Tag="Заброшено" Click="BtnTab_Click"
                    Padding="12,5"/>
        </StackPanel>

        <!-- Фильтры -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="185"/>
            </Grid.ColumnDefinitions>

            <!-- Поиск с плейсхолдером -->
            <Grid Grid.Column="0">
                <TextBox x:Name="TxtSearch"
                 Height="28" Padding="4"
                 TextChanged="Filter_Changed"/>
                <TextBlock Text="Поиск..."
                   Foreground="Gray" Padding="6,5"
                   IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}"
                                     Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ComboBox x:Name="CmbSort" Grid.Column="1"
              Margin="6,0" Height="28"
              SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="По названию" IsSelected="True"/>
                <ComboBoxItem Content="По рейтингу"/>
            </ComboBox>

            <ComboBox x:Name="CmbGenre" Grid.Column="2"
              Height="28"
              SelectionChanged="Filter_Changed"/>

        </Grid>
    </Grid>
</Page>