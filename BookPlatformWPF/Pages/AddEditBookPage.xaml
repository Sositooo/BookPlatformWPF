<Page x:Class="BookPlatformWPF.Pages.AddEditBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книга">
    <ScrollViewer>
        <StackPanel Margin="20" MaxWidth="700">
            <TextBlock x:Name="TxtPageTitle" Text="Добавить книгу"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Название *"/>
            <TextBox x:Name="TxtTitle" Height="30" Margin="0,4,0,10" Padding="4"/>

            <TextBlock Text="Описание"/>
            <TextBox x:Name="TxtDesc" Height="70" Margin="0,4,0,10"
                     TextWrapping="Wrap" AcceptsReturn="True" Padding="4"/>

            <TextBlock Text="Текст книги"/>
            <TextBox x:Name="TxtContent" Height="200" Margin="0,4,0,10"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Padding="4"/>

            <TextBlock Text="Жанры (выберите один или несколько):" Margin="0,0,0,5"/>
            <ListBox x:Name="LstGenres" Height="100" SelectionMode="Multiple"
                     DisplayMemberPath="Name" Margin="0,0,0,15"/>

            <TextBlock x:Name="LblError" Foreground="Red" Margin="0,0,0,5"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="💾 Сохранить" Padding="12,6"
                        Background="#27AE60" Foreground="White"
                        Click="BtnSave_Click"/>
                <Button Content="Отмена" Padding="12,6" Margin="8,0,0,0"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>