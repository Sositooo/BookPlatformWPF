<Page x:Class="BookPlatformWPF.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Администрирование">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚙️ Администрирование"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

        <TabControl Grid.Row="1">

            <TabItem Header="Жалобы">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="🔄 Обновить" HorizontalAlignment="Left"
                            Padding="8,4" Margin="0,5,0,5"
                            Click="BtnRefreshComplaints_Click"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ComplaintsPanel"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Заявки на разморозку">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="🔄 Обновить" HorizontalAlignment="Left"
                            Padding="8,4" Margin="0,5,0,5"
                            Click="BtnRefreshUnfreeze_Click"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="UnfreezePanel"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Заявки на автора">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="🔄 Обновить" HorizontalAlignment="Left"
                            Padding="8,4" Margin="0,5,0,5"
                            Click="BtnRefreshRoles_Click"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RoleRequestsPanel"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Замороженные">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FrozenPanel" Margin="0,8"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Пользователи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="🔄 Обновить" HorizontalAlignment="Left"
                            Padding="8,4" Margin="0,5,0,5"
                            Click="BtnRefreshUsers_Click"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="UsersPanel"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>