<Page x:Class="BookPlatformWPF.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог книг">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- фильтры -->
            <RowDefinition Height="*"/>
            <!-- книги -->
        </Grid.RowDefinitions>

        <TextBlock Text="📚 Каталог книг"
                   FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <!-- Фильтры — Grid.Row="1" -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="185"/>
            </Grid.ColumnDefinitions>

            <!-- Поиск с плейсхолдером -->
            <Grid Grid.Column="0">
                <TextBox x:Name="TxtSearch"
                 Height="30" Padding="5"
                 TextChanged="Filter_Changed"/>
                <TextBlock Text="Поиск по названию / автору"
                   Foreground="Gray" Padding="7,6"
                   IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}"
                                     Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ComboBox x:Name="CmbSort" Grid.Column="1"
              Height="30" Margin="6,0"
              SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="По названию" IsSelected="True"/>
                <ComboBoxItem Content="По рейтингу"/>
            </ComboBox>

            <ComboBox x:Name="CmbGenre" Grid.Column="2"
              Height="30"
              SelectionChanged="Filter_Changed"/>

        </Grid>

        <!-- Сетка книг -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="BooksPanel" Margin="0,4"/>
        </ScrollViewer>
    </Grid>
</Page>