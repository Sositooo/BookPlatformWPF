<Page x:Class="BookPlatformWPF.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книга">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="800">

            <!-- Инфо о книге -->
            <TextBlock x:Name="TxtTitle" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtAuthor" FontSize="14" Foreground="Gray" Margin="0,4"/>
            <TextBlock x:Name="TxtGenres" FontSize="13" Foreground="#555" Margin="0,2"/>
            <TextBlock x:Name="TxtRating" FontSize="14" Margin="0,4"/>
            <TextBlock x:Name="TxtDesc" TextWrapping="Wrap" Margin="0,8" FontSize="13"/>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Button x:Name="BtnRead" Content="📖 Читать книгу"
                        Padding="10,5" Margin="0,0,8,0"
                        Background="#4A90D9" Foreground="White"
                        Click="BtnRead_Click"/>
                <Button Content="🚩 Пожаловаться на книгу"
                        Padding="10,5" Margin="0,0,8,0"
                        Click="BtnComplainBook_Click"/>
                <!-- Только для Администратора -->
                <Button x:Name="BtnFreezeBook" Content="❄️ Заморозить книгу"
                        Padding="10,5" Visibility="Collapsed"
                        Background="#E74C3C" Foreground="White"
                        Click="BtnFreezeBook_Click"/>
            </StackPanel>

            <Separator Margin="0,10"/>

            <!-- Текст книги (раскрывается) -->
            <Border x:Name="ReadPanel" Visibility="Collapsed"
                    Background="#FAFAFA" BorderBrush="LightGray"
                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtContent" TextWrapping="Wrap" FontSize="13"/>
                </ScrollViewer>
            </Border>

            <!-- Отзывы -->
            <TextBlock Text="Отзывы" FontSize="18" FontWeight="Bold" Margin="0,10,0,5"/>

            <!-- Форма отзыва -->
            <Border Background="#F0F0F0" Padding="10" CornerRadius="4" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Оставить отзыв:" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtReview" Height="60" Margin="0,5"
                             TextWrapping="Wrap" AcceptsReturn="True" Padding="4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Оценка (1-10):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbRating" Width="60">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5" IsSelected="True"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                            <ComboBoxItem Content="10"/>
                        </ComboBox>
                        <Button Content="Отправить" Padding="10,4" Margin="8,0,0,0"
                                Background="#27AE60" Foreground="White"
                                Click="BtnSubmitReview_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Список отзывов -->
            <StackPanel x:Name="ReviewsPanel"/>

        </StackPanel>
    </ScrollViewer>
</Page>