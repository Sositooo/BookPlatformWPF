<Window x:Class="BookPlatformWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- САЙДБАР -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel VerticalAlignment="Top" Margin="0,10">

                <!-- Каталог -->
                <Button Style="{StaticResource SidebarBtn}"
                        Click="BtnCatalog_Click" Foreground="White">
                    <Button.ToolTip>
                        <ToolTip Content="Каталог книг"/>
                    </Button.ToolTip>
                    📚
                </Button>

                <!-- Списки книг -->
                <Button Style="{StaticResource SidebarBtn}"
                        Click="BtnLists_Click" Foreground="White">
                    <Button.ToolTip>
                        <ToolTip Content="Списки книг"/>
                    </Button.ToolTip>
                    📋
                </Button>

                <!-- Страница автора (только для Автора) -->
                <Button x:Name="BtnAuthorNav" Style="{StaticResource SidebarBtn}"
                        Click="BtnAuthor_Click" Foreground="White" Visibility="Collapsed">
                    <Button.ToolTip>
                        <ToolTip Content="Страница автора"/>
                    </Button.ToolTip>
                    ✍️
                </Button>

                <!-- Администрирование (только для Администратора) -->
                <Button x:Name="BtnAdminNav" Style="{StaticResource SidebarBtn}"
                        Click="BtnAdmin_Click" Foreground="White" Visibility="Collapsed">
                    <Button.ToolTip>
                        <ToolTip Content="Администрирование"/>
                    </Button.ToolTip>
                    ⚙️
                </Button>

                <!-- Предупреждение заморозки (только если аккаунт заморожен) -->
                <Button x:Name="BtnFreezeWarn" Style="{StaticResource SidebarBtn}"
                        Click="BtnFreezeWarn_Click" Foreground="Orange" Visibility="Collapsed">
                    <Button.ToolTip>
                        <ToolTip Content="Аккаунт заморожен!"/>
                    </Button.ToolTip>
                    ⚠️
                </Button>

                <!-- Профиль (снизу) -->
                <Button Style="{StaticResource SidebarBtn}"
                        Click="BtnProfile_Click" Foreground="White" Margin="5,200,5,5">
                    <Button.ToolTip>
                        <ToolTip Content="Профиль"/>
                    </Button.ToolTip>
                    👤
                </Button>

            </StackPanel>
        </Border>

        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <Frame x:Name="MainFrame" Grid.Column="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>