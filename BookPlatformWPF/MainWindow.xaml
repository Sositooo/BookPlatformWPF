<Window x:Class="BookPlatformWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <!-- сайдбар -->
            <ColumnDefinition Width="*"/>
            <!-- основная область -->
        </Grid.ColumnDefinitions>

        <!-- ── САЙДБАР ── -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel VerticalAlignment="Top" Margin="0,10">

                <!-- Каталог — открыт по умолчанию -->
                <Button Style="{StaticResource SidebarBtn}"
                        Foreground="White"
                        Click="BtnCatalog_Click">
                    <Button.ToolTip>
                        <ToolTip Content="Каталог книг"/>
                    </Button.ToolTip>
                    📚
                </Button>

                <!-- Списки книг -->
                <Button Style="{StaticResource SidebarBtn}"
                        Foreground="White"
                        Click="BtnLists_Click">
                    <Button.ToolTip>
                        <ToolTip Content="Списки книг"/>
                    </Button.ToolTip>
                    📋
                </Button>

                <!-- Страница автора — только для роли Автор -->
                <Button x:Name="BtnAuthorNav"
                        Style="{StaticResource SidebarBtn}"
                        Foreground="White"
                        Visibility="Collapsed"
                        Click="BtnAuthor_Click">
                    <Button.ToolTip>
                        <ToolTip Content="Страница автора"/>
                    </Button.ToolTip>
                    ✍️
                </Button>

                <!-- Администрирование — только для роли Администратор -->
                <Button x:Name="BtnAdminNav"
                        Style="{StaticResource SidebarBtn}"
                        Foreground="White"
                        Visibility="Collapsed"
                        Click="BtnAdmin_Click">
                    <Button.ToolTip>
                        <ToolTip Content="Администрирование"/>
                    </Button.ToolTip>
                    ⚙️
                </Button>

                <!-- Предупреждение заморозки — только если аккаунт заморожен -->
                <Button x:Name="BtnFreezeWarn"
                        Style="{StaticResource SidebarBtn}"
                        Foreground="Orange"
                        Visibility="Collapsed"
                        Click="BtnFreezeWarn_Click">
                    <Button.ToolTip>
                        <ToolTip Content="Аккаунт заморожен!"/>
                    </Button.ToolTip>
                    ⚠️
                </Button>

                <!-- Профиль — всегда виден, прижат вниз -->
                <Button Style="{StaticResource SidebarBtn}"
                        Foreground="White"
                        Margin="5,180,5,5"
                        Click="BtnProfile_Click">
                    <Button.ToolTip>
                        <ToolTip Content="Профиль"/>
                    </Button.ToolTip>
                    👤
                </Button>

            </StackPanel>
        </Border>

        <!-- ── ОСНОВНАЯ ОБЛАСТЬ ── -->
        <Frame x:Name="MainFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>